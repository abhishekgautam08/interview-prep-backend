# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/interview_prep

# Authentication
JWT_SECRET=super_secret_jwt_key_interview_prep_kit_2026

# LLM Providers (Genuine Free Tier options: Gemini, Groq, or Mock)
# Set LLM_PROVIDER to: 'gemini' | 'groq' | 'openai' | 'mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Rate Limiting & Timeouts
MAX_REQUESTS_PER_MINUTE=15
LLM_TIMEOUT_MS=45000
CRAWLER_TIMEOUT_MS=8000
